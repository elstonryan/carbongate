# ── Supabase (live auth + DB) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (server-side only — NEVER expose to browser) ───────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...       # text-embedding-3-large for corpus

# ── Feature flags ─────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK_DATA=true   # set false for live Supabase
